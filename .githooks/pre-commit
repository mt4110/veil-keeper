#!/bin/sh
set -eu

if git diff --cached --quiet -- Cargo.toml Cargo.lock; then
    exit 0
else
    status=$?
    [ "$status" -eq 1 ] || exit "$status"
fi

if ! command -v osv-scanner >/dev/null 2>&1; then
    printf '%s\n' 'Install OSV-Scanner 2.x to check staged Cargo dependency changes.' >&2
    exit 1
fi

scan_dir=$(mktemp -d "${TMPDIR:-/tmp}/veil-keeper-osv.XXXXXXXX")
trap 'rm -f "$scan_dir/Cargo.lock"; rmdir "$scan_dir"' EXIT
trap 'exit 129' HUP
trap 'exit 130' INT
trap 'exit 143' TERM

if ! git show :Cargo.lock > "$scan_dir/Cargo.lock"; then
    printf '%s\n' 'Stage Cargo.lock before committing Cargo dependency changes.' >&2
    exit 1
fi

osv-scanner scan source --lockfile "$scan_dir/Cargo.lock" --no-resolve
