{
  "schema_version": 2,
  "scope": "socket_cgroup_v1",
  "environment": {
    "system": "Linux",
    "os_id": "ubuntu",
    "os_version": "24.04",
    "machine": "x86_64",
    "boot_id": "11111111-1111-4111-8111-111111111111",
    "manager": "system"
  },
  "boundary": {
    "slice": "veilkeepertrial.slice",
    "path": "/veilkeepertrial.slice",
    "cgroup_id": 314159,
    "ancestor_level": 1,
    "config_sha256": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"
  },
  "service": {
    "canonical_name": "e1-target.service",
    "parent_slice": "veilkeepertrial.slice",
